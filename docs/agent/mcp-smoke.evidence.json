{
  "scope": "local in-process HTTP with realistic fakes",
  "networkMailAccess": false,
  "oauthConsent": false,
  "productionCredentials": false,
  "deployment": false,
  "transport": "@modelcontextprotocol/sdk WebStandardStreamableHTTPServerTransport",
  "protocolVersion": "2025-11-25",
  "sequence": [
    "initialize",
    "notifications/initialized",
    "tools/list",
    "getThreadContext",
    "createReplyDraft",
    "getDraft",
    "updateDraft"
  ],
  "listedTools": ["getThreadContext", "createReplyDraft", "listDrafts", "getDraft", "updateDraft"],
  "context": {
    "maximumMessages": 20,
    "maximumTextBytes": 65536,
    "sanitizedEveryReturnedBody": true,
    "rawAttachmentsReturned": false,
    "rawHeadersReturned": false
  },
  "reply": {
    "recipientsDerivedServerSide": true,
    "subjectDerivedServerSide": true,
    "threadIdentityDerivedServerSide": true,
    "sameProviderDraftIdAfterUpdate": true
  },
  "draftUpdate": {
    "requiredConcurrencyControl": "provider-native-atomic-cas",
    "casFakeAdvertisedSupport": true,
    "revisionBoundToProviderToken": true,
    "freshRevisionAfterSuccess": true,
    "concurrentEditResult": "412-equivalent",
    "concurrentEditOverwrites": 0,
    "noCasFakeAdvertisedSupport": false,
    "noCasIdempotencyReservations": 0,
    "noCasProviderReadsDuringUpdate": 0,
    "noCasConditionalWriteAttempts": 0,
    "noCasProviderMutations": 0,
    "noCasFallback": "create a new unsent draft for human review"
  },
  "idempotency": {
    "concurrentCallsPerMutation": 20,
    "providerEffectsPerSameKeyPayload": 1,
    "changedPayloadConflictsBeforeMutation": true
  },
  "staleRevisionChanges": 0,
  "sendCallsObserved": 0,
  "forbiddenToolsPresent": false
}

{
  "name": "zero",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "go": "pnpm docker:db:up && pnpm run dev",
    "prepare": "husky",
    "nizzy": "tsx ./packages/cli/src/cli.ts",
    "postinstall": "pnpm nizzy sync",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "build:frontend": "pnpm run --filter=@zero/mail build",
    "deploy:frontend": "echo 'ERREUR: `wrangler deploy` sans --env deploie le worker racine (pas staging/production) et echoue au build car les regles de chargement .sql vivent dans les blocs d env. Utiliser deploy:staging ou deploy:production.' && exit 1",
    "deploy:backend": "echo 'ERREUR: `wrangler deploy` sans --env deploie le worker racine (pas staging/production) et echoue au build car les regles de chargement .sql vivent dans les blocs d env. Utiliser deploy:staging ou deploy:production.' && exit 1",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "format": "prettier --write apps/**/*.{ts,tsx} --log-level silent",
    "check": "pnpm run check:format && pnpm run lint",
    "check:format": "prettier . --check",
    "docker:db:up": "docker compose -f docker-compose.db.yaml up -d",
    "docker:db:stop": "docker compose -f docker-compose.db.yaml stop",
    "docker:db:down": "docker compose -f docker-compose.db.yaml down",
    "docker:db:clean": "docker compose -f docker-compose.db.yaml down -v",
    "db:generate": "dotenv -- pnpm run -C apps/server db:generate",
    "db:migrate": "dotenv -- pnpm run -C apps/server db:migrate",
    "db:push": "dotenv -- pnpm run -C apps/server db:push",
    "db:studio": "dotenv -- pnpm run -C apps/server db:studio",
    "sentry:sourcemaps": "sentry-cli sourcemaps inject --org zero-7y --project nextjs ./apps/mail/.next && sentry-cli sourcemaps upload --org zero-7y --project nextjs ./apps/mail/.next",
    "scripts": "dotenv -- pnpx tsx ./scripts/run.ts",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter=@zero/testing test:e2e",
    "eval": "dotenv -- pnpm --filter=@zero/server run eval",
    "eval:dev": "dotenv -- pnpm --filter=@zero/server run eval:dev",
    "deploy:staging": "pnpm run --filter=@zero/server deploy:staging && pnpm run --filter=@zero/mail deploy:staging",
    "deploy:production": "pnpm run --filter=@zero/server deploy:production && pnpm run --filter=@zero/mail deploy:production"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "pnpm dlx oxlint@1.9.0 --deny-warnings",
      "prettier --write"
    ],
    "*.{js,jsx,mjs,cjs,json,jsonc,md,mdx,css,html,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "@zero/tsconfig": "workspace:*",
    "dotenv-cli": "^10.0.0",
    "husky": "9.1.7",
    "prettier": "3.6.2",
    "prettier-plugin-sort-imports": "1.8.8",
    "prettier-plugin-tailwindcss": "0.6.14",
    "tsx": "4.20.5",
    "turbo": "^2.5.6",
    "typescript": "catalog:"
  },
  "dependencies": {
    "drizzle-kit": "catalog:",
    "react-router": "7.18.1",
    "zod": "4.1.1",
    "zod-to-json-schema": "3.24.6"
  },
  "pnpm": {
    "overrides": {
      "@modelcontextprotocol/sdk": "1.29.0",
      "form-data": "4.0.6",
      "happy-dom": "20.10.6",
      "protobufjs": "7.6.5",
      "vitest": "3.2.7",
      "ws": "8.21.0",
      "fast-uri": "3.1.3",
      "path-to-regexp@8": "8.4.2",
      "jws@4": "4.0.1",
      "jws@3": "3.2.3",
      "flatted": "3.4.2",
      "preact": "10.29.7",
      "linkifyjs": "4.3.3",
      "linkify-it": "5.0.2",
      "js-cookie@3": "3.0.8",
      "tar": "7.5.19",
      "tar-fs": "2.1.5"
    }
  }
}

{
  // Declaration-emit project for the apps/mail type boundary (issue devlab-io/zero#43).
  // Emits the declaration of `src/trpc/index.ts` (the `AppRouter` definition) so the
  // generator (scripts/gen-trpc-boundary.mjs) can commit a self-contained boundary
  // `.d.ts`. Inherits the app's strict settings; only turns emit on. `createAuth` (via ctx)
  // est non portable et remonte en erreur d'émission, mais ne bloque PAS `index.d.ts` — le
  // générateur valide son artefact plutôt que le code de sortie. `serverTrpc` a été supprimé
  // (amendement 2026-07-26 de l'ADR 0006 : son re-export formait un cycle de valeur).
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "incremental": false,
    "rootDir": "src",
    "outDir": "node_modules/.cache/trpc-boundary"
  },
  "include": ["src/trpc/index.ts", "worker-configuration.d.ts", "src/overrides.d.ts"]
}

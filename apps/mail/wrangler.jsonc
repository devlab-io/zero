{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zero",
  "compatibility_date": "2025-06-27",
  "observability": {
    "enabled": true,
  },
  "main": "workers/spa-fallback.ts",
  "assets": {
    "directory": "./build/client/",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "html_handling": "force-trailing-slash",
  },
  "env": {
    "local": {
      "name": "zero-local",
      "vars": {
        "VITE_PUBLIC_BACKEND_URL": "http://localhost:8787",
        "VITE_PUBLIC_APP_URL": "http://localhost:3000",
      },
    },
    "staging": {
      "name": "zero-staging",
      "vars": {
        "VITE_PUBLIC_BACKEND_URL": "https://zero-server-staging.devlab-tahiti.workers.dev",
        "VITE_PUBLIC_APP_URL": "https://zero-staging.devlab-tahiti.workers.dev",
      },
    },
    "production": {
      "name": "zero-production",
      "vars": {
        "VITE_PUBLIC_BACKEND_URL": "https://api.0.email",
        "VITE_PUBLIC_APP_URL": "https://0.email",
      },
    },
  },
}

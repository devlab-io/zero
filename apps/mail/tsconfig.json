{
  "extends": "@zero/tsconfig/base",
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "types": ["node", "vite/client"],
    "paths": {
      "@/*": ["./*"],
      // AppRouter type boundary (issue devlab-io/zero#43): resolve `@zero/server/trpc`
      // from a self-contained generated declaration instead of the server source, so
      // tsc stops compiling the server module graph under mail's Env. Regenerated by
      // `pnpm --filter @zero/server gen:trpc-boundary`. See docs/adr/0006-trpc-type-boundary.md.
      "@zero/server/trpc": ["../server/src/trpc/app-router.boundary.d.ts"],
      // Auth type boundary (issue devlab-io/zero#43): apps/mail imports only the `Auth`
      // type; resolve it from a self-contained leaf declaration instead of the server
      // source (which pulls createAuth -> env/driver/db). See docs/adr/0006-trpc-type-boundary.md.
      // The `dormroom` shim (#21) was removed here: with `@zero/server/trpc` and
      // `@zero/server/auth` resolved from the type boundary above, apps/mail's tsc no
      // longer walks the server sources that pulled `dormroom`'s strict-incompatible
      // `.ts`, so the shim is dead (verified: `tsc --noEmit` = 0 without it). Issue #43.
      "@zero/server/auth": ["../server/src/lib/auth.boundary.d.ts"]
    },
    "rootDirs": [".", "./.react-router/types"]
  },
  "include": ["**/*.ts", "**/*.tsx", "worker-configuration.d.ts"],
  "exclude": ["node_modules"]
}
